# ---------------------------------------------------------------------------
# MindNodeX CDP Sandbox — environment variable reference
#
# Copy this file to .env and fill in your values.
# NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

# Server port (default: 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Mode selection
#   sandbox  — safe default, uses simulated CDP sandbox endpoints (default)
#   live     — real funds; requires LIVE_ACCOUNT_ID to be set
# ---------------------------------------------------------------------------
CDP_MODE=sandbox

# ---------------------------------------------------------------------------
# Sandbox mode
#   Override the default sandbox account ID if needed.
#   Leave blank to use the built-in default.
# ---------------------------------------------------------------------------
# ACCOUNT_ID=account_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Live mode  (only used when CDP_MODE=live)
#   LIVE_ACCOUNT_ID must be set or the server will refuse to start.
# ---------------------------------------------------------------------------
# LIVE_ACCOUNT_ID=account_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
