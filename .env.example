# Environment example for MindNodeX CDP Sandbox

# Default mode: sandbox
CDP_MODE=sandbox

# Set to true only when you intentionally want live mode
ENABLE_LIVE=false

# Required only for live mode
LIVE_ACCOUNT_ID=

# Optional sandbox account override
ACCOUNT_ID=account_2fccb8de-2e2f-4742-92f7-547451794f9a
