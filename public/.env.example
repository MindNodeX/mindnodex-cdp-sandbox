# MindNodeX CDP Sandbox — environment variables
# Copy this to .env and fill in your values.
# Never commit secrets.

PORT=3000

# Mode selection
# sandbox = current default behavior
# live = separate live-mode config split
CDP_MODE=sandbox

# Sandbox account override (optional)
ACCOUNT_ID=account_2fccb8de-2e2f-4742-92f7-547451794f9a

# Live mode only
LIVE_ACCOUNT_ID=account_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
